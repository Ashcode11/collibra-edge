[mysqld]
# Sized for a 512 MiB container on a laptop
innodb_buffer_pool_size = 64M
innodb_log_buffer_size  = 8M
performance_schema      = OFF
max_connections         = 50
skip-name-resolve
character-set-server    = utf8mb4
collation-server        = utf8mb4_0900_ai_ci
# Auditability
log_error_verbosity     = 3
