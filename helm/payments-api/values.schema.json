{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["image", "config", "database", "resources"],
  "properties": {
    "replicaCount": { "type": "integer", "minimum": 1 },
    "image": {
      "type": "object",
      "required": ["repository"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string", "not": { "const": "latest" } },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "config": {
      "type": "object",
      "required": ["DB_HOST", "DB_NAME"],
      "properties": { "LOG_LEVEL": { "enum": ["DEBUG", "INFO", "WARNING", "ERROR"] } },
      "additionalProperties": { "type": "string" }
    },
    "database": {
      "type": "object",
      "required": ["existingSecret"],
      "properties": { "existingSecret": { "type": "string", "minLength": 1 } }
    },
    "resources": {
      "type": "object",
      "required": ["requests", "limits"],
      "properties": { "limits": { "type": "object", "required": ["memory"] } }
    },
    "autoscaling": {
      "type": "object",
      "properties": {
        "minReplicas": { "type": "integer", "minimum": 1 },
        "maxReplicas": { "type": "integer", "minimum": 1 },
        "targetCPUUtilizationPercentage": { "type": "integer", "minimum": 10, "maximum": 95 }
      }
    }
  }
}
